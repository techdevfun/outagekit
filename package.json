{
  "author": "TECHDEV",
  "bin": {
    "outagekit": "./dist/cli.js"
  },
  "description": "Audit your vendor-outage readiness from your own runbooks - one command that shows whether your team is ready for your biggest vendor's next bad day.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "outage",
    "readiness",
    "runbook",
    "incident",
    "business-continuity",
    "governance",
    "devops",
    "audit"
  ],
  "license": "MIT",
  "name": "outagekit",
  "repository": {
    "type": "git",
    "url": "https://github.com/techdevfun/outagekit.git"
  },
  "scripts": {
    "bench": "node scripts/bench.js",
    "build": "tsc",
    "preflight": "node scripts/preflight.js",
    "test": "node --test test/unit.test.js test/e2e.test.js",
    "test:live": "node --test test/live.test.js",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\""
  },
  "type": "module",
  "version": "0.1.0"
}
